{%- comment -%}
  Daily Melt — centered heading + columns separated by a top rule (one per step) + optional CTA.
  Used for "How to use" on the PDP.
{%- endcomment -%}

{%- assign ss = section.settings -%}

{%- liquid
  assign section_bg = ''
  if ss.background_start != blank and ss.background_end != blank
    assign section_bg = 'linear-gradient(180deg, ' | append: ss.background_start | append: ' 0%, ' | append: ss.background_end | append: ' 100%)'
  elsif ss.background_start != blank
    assign section_bg = ss.background_start
  endif
-%}
<div class="section-background"{% if section_bg != blank %} style="background: {{ section_bg }};"{% endif %}></div>
<div
  class="dm-steps section section--page-width"
  style="--dm-pt: {{ ss.padding_top | divided_by: 16.0 }}rem; --dm-pb: {{ ss.padding_bottom | divided_by: 16.0 }}rem; --dm-cols: {{ ss.columns }}; {% render 'dm-font-var', name: 'step-number', font: ss.dm_font_number, text_case: ss.dm_case_number %}{% render 'dm-font-var', name: 'step-title', font: ss.dm_font_title, text_case: ss.dm_case_title %}{% if ss.accent_color != blank %} --dm-accent: {{ ss.accent_color }};{% endif %}"
>
  <div class="dm-steps__inner">
    {%- if ss.heading != blank or ss.text != blank -%}
      <header class="dm-steps__header">
        {%- if ss.heading != blank -%}
          <h2 class="dm-steps__heading h2">{{ ss.heading }}</h2>
        {%- endif -%}
        {%- if ss.text != blank -%}
          <div class="dm-steps__text">{{ ss.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ol class="dm-steps__list" role="list">
      {% content_for 'blocks' %}
    </ol>

    {%- if ss.button_label != blank -%}
      <div class="dm-steps__cta">
        <a class="button" href="{{ ss.button_link | default: '#dm-buy' }}">{{ ss.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dm-steps {
    padding-block: calc(var(--dm-pt) * var(--dm-space, 1)) calc(var(--dm-pb) * var(--dm-space, 1));
  }

  .dm-steps__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .dm-steps__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .dm-steps__heading {
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }

  .dm-steps__text {
    max-width: 62ch;
  }

  .dm-steps__text p {
    margin: 0;
  }

  .dm-steps__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dm-steps__cta {
    display: flex;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .dm-steps__inner {
      gap: 56px;
    }

    .dm-steps__list {
      grid-template-columns: repeat(var(--dm-cols, 3), minmax(0, 1fr));
      column-gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Steps",
  "tag": "section",
  "class": "dm-section",
  "blocks": [
    {
      "type": "_dm-step"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Ritual in Three Simple Steps"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Your Daily Melt"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the purchase options."
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background (top)",
      "default": "{{ settings.color_palette.cream_light }}"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background (bottom)",
      "info": "Use the same color as the top for a solid background.",
      "default": "{{ settings.color_palette.caramel }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Step number color",
      "default": "{{ settings.color_palette.accent }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "dm_font_number",
      "label": "Step numbers font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "dm_case_number",
      "label": "Step numbers case",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "dm_font_title",
      "label": "Step titles font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "subheading"
    },
    {
      "type": "select",
      "id": "dm_case_title",
      "label": "Step titles case",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ],
      "default": "",
      "info": "Fonts come from Theme settings > Typography. Case: Default keeps the design."
    }
  ],
  "presets": [
    {
      "name": "DM · Steps",
      "blocks": {
        "step_1": {
          "type": "_dm-step",
          "settings": {
            "number": "1"
          }
        },
        "step_2": {
          "type": "_dm-step",
          "settings": {
            "number": "2"
          }
        },
        "step_3": {
          "type": "_dm-step",
          "settings": {
            "number": "3"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ]
    }
  ]
}
{% endschema %}
