{%- doc -%}
  Daily Melt — one tab panel of DM · Tabs: image + text card (heading, text, checklist).
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign items = bs.items | newline_to_br | split: '<br />'
-%}
<div class="dm-tab" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
<button
  type="button"
  class="dm-tabs__tab"
  role="tab"
  id="dm-tab-{{ block.id }}"
  aria-controls="dm-panel-{{ block.id }}"
  aria-selected="false"
  tabindex="-1"
  data-block-id="{{ block.id }}"
>
  {{- bs.label | default: bs.heading -}}
</button>
<div
  class="dm-tab-panel"
  role="tabpanel"
  id="dm-panel-{{ block.id }}"
  aria-labelledby="dm-tab-{{ block.id }}"
  data-block-id="{{ block.id }}"
>
  <div class="dm-tab-panel__media">
    {%- if bs.image != blank -%}
      {{ bs.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', class: 'dm-tab-panel__image' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'dm-tab-panel__image dm-tab-panel__image--placeholder' }}
    {%- endif -%}
  </div>
  <div class="dm-tab-panel__card">
    {%- if bs.heading != blank -%}
      <h3 class="dm-tab-panel__heading">{{ bs.heading }}</h3>
    {%- endif -%}
    {%- if bs.text != blank -%}
      <div class="dm-tab-panel__text">{{ bs.text }}</div>
    {%- endif -%}
    {%- if bs.items != blank -%}
      <ul class="dm-tab-panel__list" role="list">
        {%- for item in items -%}
          {%- assign label = item | strip -%}
          {%- if label != blank -%}
            <li>
              <span class="dm-tab-panel__check" aria-hidden="true">{% render 'dm-icon', icon: 'check' %}</span>
              <span>{{ label }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
</div>

{% stylesheet %}
  .dm-tab-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .dm-tab-panel[hidden] {
    display: none;
  }

  .dm-tab-panel__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--dm-accent, currentColor);
    border-radius: var(--dm-radius, 0);
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .dm-tab-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dm-tab-panel__image--placeholder {
    fill: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .dm-tab-panel__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 32px 24px;
    border-radius: var(--dm-radius, 0);
    background: var(--dm-panel-bg, transparent);
  }

  .dm-tab-panel__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .dm-tab-panel__text p {
    margin: 0;
  }

  .dm-tab-panel__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .dm-tab-panel__list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .dm-tab-panel__check {
    flex: 0 0 auto;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.15em;
    color: var(--dm-accent, currentColor);
  }

  .dm-tab-panel__check svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .dm-tab-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .dm-tab-panel__media {
      aspect-ratio: 1;
    }

    .dm-tab-panel__card {
      padding: 48px 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Tab label",
      "default": "Ingredient"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredient"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "Checklist",
      "info": "One item per line."
    }
  ],
  "presets": [
    {
      "name": "DM · Tab"
    }
  ]
}
{% endschema %}

