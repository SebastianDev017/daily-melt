{%- doc -%}
  Daily Melt — card of DM · Cards: image with tag, title, subtitle, checklist and optional "Learn more".
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign items = bs.items | newline_to_br | split: '<br />'
-%}
<li class="dm-card" {{ block.shopify_attributes }}>
  {%- if bs.show_image -%}
    <div class="dm-card__media">
      {%- if bs.image != blank -%}
        {{ bs.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', class: 'dm-card__image' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'dm-card__image dm-card__image--placeholder' }}
      {%- endif -%}
      {%- if bs.tag != blank -%}
        <span class="dm-card__tag">{{ bs.tag }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="dm-card__body">
    {%- if bs.show_image == false and bs.tag != blank -%}
      <span class="dm-card__tag dm-card__tag--inline">{{ bs.tag }}</span>
    {%- endif -%}
    {%- if bs.title != blank -%}
      <h3 class="dm-card__title">{{ bs.title }}</h3>
    {%- endif -%}
    {%- if bs.subtitle != blank -%}
      <p class="dm-card__subtitle">{{ bs.subtitle }}</p>
    {%- endif -%}
    <ul class="dm-card__list" role="list">
      {%- for item in items -%}
        {%- assign label = item | strip -%}
        {%- if label != blank -%}
          <li>
            <span class="dm-card__check" aria-hidden="true">{% render 'dm-icon', icon: 'check' %}</span>
            <span>{{ label }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if bs.more_text != blank -%}
      <details class="dm-card__more">
        <summary class="dm-card__more-toggle">
          {{ bs.more_label }}
          <span class="dm-card__more-icon" aria-hidden="true">{% render 'dm-icon', icon: 'chevron_down' %}</span>
        </summary>
        <div class="dm-card__more-text">{{ bs.more_text }}</div>
      </details>
    {%- endif -%}
  </div>
</li>

{% stylesheet %}
  .dm-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--dm-radius, 0);
    background: var(--dm-card-bg, #fff);
    color: var(--dm-card-text, inherit);
  }

  .dm-card__media {
    position: relative;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .dm-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dm-card__image--placeholder {
    fill: currentColor;
    opacity: 0.3;
  }

  .dm-card__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 10px;
    background: var(--dm-accent);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .dm-card__tag--inline {
    position: static;
    align-self: flex-start;
  }

  .dm-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 28px;
  }

  .dm-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
  }

  .dm-card__subtitle {
    margin: 0;
    font-style: italic;
  }

  .dm-card__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .dm-card__list li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .dm-card__check {
    flex: 0 0 auto;
    width: 1em;
    height: 1em;
    margin-top: 0.2em;
    color: var(--dm-accent);
  }

  .dm-card__check svg {
    width: 100%;
    height: 100%;
  }

  .dm-card__more {
    margin-top: auto;
    padding-top: 8px;
  }

  .dm-card__more-toggle {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    cursor: pointer;
    list-style: none;
  }

  .dm-card__more-toggle::-webkit-details-marker {
    display: none;
  }

  .dm-card__more-icon {
    width: 14px;
    height: 14px;
    color: var(--dm-accent);
    transition: transform 0.2s ease;
  }

  .dm-card__more[open] .dm-card__more-icon {
    transform: rotate(180deg);
  }

  .dm-card__more-text {
    padding-top: 10px;
    font-size: 0.875rem;
  }

  .dm-card__more-text p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Card",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Month 1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Card title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "Checklist",
      "info": "One item per line."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Learn more label",
      "default": "Learn More"
    },
    {
      "type": "richtext",
      "id": "more_text",
      "label": "Learn more text",
      "info": "Leave empty to hide the toggle."
    }
  ],
  "presets": [
    {
      "name": "DM · Card"
    }
  ]
}
{% endschema %}

