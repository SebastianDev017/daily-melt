{%- doc -%}
  Daily Melt — purchase options (subscribe vs. one-time) built on Shopify's native selling plans.
  Recharge (Shopify Checkout integration) creates native selling plan groups, so the plan picked here
  is sent to the cart as the standard `selling_plan` field of Horizon's product form.
  When the product has no selling plans yet, the subscription card shows DEMO pricing
  (variant price minus the demo discount) and the cart receives a one-time purchase.

  Child blocks (Buy buttons, Supplement facts popup, etc.) render under the cards.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign allocations = variant.selling_plan_allocations
  assign has_plans = false
  if allocations.size > 0
    assign has_plans = true
  endif

  assign show_one_time = true
  if product.requires_selling_plan and has_plans
    assign show_one_time = false
  endif

  assign servings = 0
  if bs.show_per_serving and bs.servings > 0
    assign servings = bs.servings
  endif

  assign default_plan_id = ''
  if has_plans
    assign default_index = bs.default_plan_position | minus: 1
    if default_index >= allocations.size
      assign default_index = 0
    endif
    assign default_allocation = allocations[default_index]
    assign default_plan_id = default_allocation.selling_plan.id
  endif

  assign selected = bs.default_option
  if show_one_time == false
    assign selected = 'subscription'
  endif

  assign group_name = 'dm-purchase-' | append: block.id
-%}

{% if product != blank %}
  <script src="{{ 'dm-pdp.js' | asset_url }}" type="module"></script>

  <dm-purchase-options
    id="dm-buy"
    class="dm-purchase{% if bs.mobile_buttons_first %} dm-purchase--buttons-first{% endif %} dm-purchase--perks-{{ bs.perks_style }} spacing-style"
    style="{% render 'spacing-style', settings: bs %} --dm-card-radius: {{ bs.card_radius }}px; --dm-card-border: {{ bs.card_border }}px; --dm-accent: {{ bs.accent_color }}; --dm-selected-bg: {{ bs.selected_background }}; {% render 'dm-font-var', name: 'option-title', font: bs.dm_font_title %}{% render 'dm-font-var', name: 'option-badge', font: bs.dm_font_badge %}"
    data-form-id="{{ form_id }}"
    data-has-plans="{{ has_plans }}"
    data-show-button-price="{{ bs.show_button_price }}"
    {{ block.shopify_attributes }}
  >
    {%- if bs.label != blank or bs.link_label != blank -%}
      <div class="dm-purchase__header">
        {%- if bs.label != blank -%}
          <p class="dm-purchase__label">{{ bs.label }}</p>
        {%- endif -%}
        {%- if bs.link_label != blank -%}
          <a class="dm-purchase__link" href="{{ bs.link | default: '#' }}">{{ bs.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dm-purchase__options" role="radiogroup" aria-label="{{ 'dm.purchase.options_label' | t }}">
      {%- capture subscription_cards -%}
        {%- if has_plans == false -%}
          {%- liquid
            assign keep = 100 | minus: bs.demo_discount
            assign demo_price = variant.price | times: keep | divided_by: 100
            assign is_checked = false
            if selected == 'subscription'
              assign is_checked = true
            endif
          -%}
          {% render 'dm-purchase-card',
            option: 'subscription',
            group_name: group_name,
            checked: is_checked,
            badge: bs.sub_badge,
            title: bs.sub_title,
            price: demo_price,
            compare: variant.price,
            price_suffix: bs.sub_price_suffix,
            servings: servings,
            per_serving_suffix: bs.per_serving_suffix,
            subtitle: bs.sub_subtitle,
            perks: bs.sub_perks
          %}
        {%- elsif bs.plan_display == 'cards' -%}
          {%- for allocation in allocations -%}
            {%- liquid
              assign is_default = false
              if allocation.selling_plan.id == default_plan_id
                assign is_default = true
              endif
              assign is_checked = false
              if is_default and selected == 'subscription'
                assign is_checked = true
              endif
              assign adjustment = allocation.selling_plan.price_adjustments.first
              assign card_badge = ''
              if bs.auto_badges and adjustment.value_type == 'percentage' and adjustment.value > 0
                assign card_badge = bs.auto_badge_format | replace: '[percent]', adjustment.value
              endif
              assign card_title = allocation.selling_plan.name
              if is_default
                if bs.sub_badge != blank
                  assign card_badge = bs.sub_badge
                endif
                if bs.sub_title != blank
                  assign card_title = bs.sub_title
                endif
              endif
            -%}
            {% render 'dm-purchase-card',
              option: 'subscription',
              group_name: group_name,
              checked: is_checked,
              plan_id: allocation.selling_plan.id,
              badge: card_badge,
              title: card_title,
              price: allocation.price,
              compare: allocation.compare_at_price,
              price_suffix: bs.sub_price_suffix,
              servings: servings,
              per_serving_suffix: bs.per_serving_suffix,
              subtitle: bs.sub_subtitle,
              perks: bs.sub_perks
            %}
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign is_checked = false
            if selected == 'subscription'
              assign is_checked = true
            endif
          -%}
          {%- capture select_html -%}
            {%- if bs.plan_display == 'selector' and allocations.size > 1 -%}
              <span class="dm-option__frequency">
                {%- if bs.frequency_label != blank -%}
                  <span class="dm-option__frequency-label">{{ bs.frequency_label }}</span>
                {%- endif -%}
                <select
                  class="dm-option__select"
                  aria-label="{{ bs.frequency_label | default: bs.sub_title | escape }}"
                  data-dm-plan-select
                >
                  {%- for allocation in allocations -%}
                    {%- liquid
                      assign plan_per_serving = ''
                      if servings > 0
                        assign plan_per_serving = allocation.price | divided_by: servings | money
                      endif
                      assign plan_compare = ''
                      if allocation.compare_at_price != allocation.price
                        assign plan_compare = allocation.compare_at_price | money
                      endif
                    -%}
                    <option
                      value="{{ allocation.selling_plan.id }}"
                      data-price="{{ allocation.price | money }}"
                      data-compare="{{ plan_compare }}"
                      data-per-serving="{{ plan_per_serving }}"
                      {% if allocation.selling_plan.id == default_plan_id %}
                        selected
                      {% endif %}
                    >
                      {{- allocation.selling_plan.name -}}
                    </option>
                  {%- endfor -%}
                </select>
              </span>
            {%- endif -%}
          {%- endcapture -%}
          {% render 'dm-purchase-card',
            option: 'subscription',
            group_name: group_name,
            checked: is_checked,
            plan_id: default_plan_id,
            badge: bs.sub_badge,
            title: bs.sub_title,
            price: default_allocation.price,
            compare: default_allocation.compare_at_price,
            price_suffix: bs.sub_price_suffix,
            servings: servings,
            per_serving_suffix: bs.per_serving_suffix,
            subtitle: bs.sub_subtitle,
            perks: bs.sub_perks,
            select_html: select_html
          %}
        {%- endif -%}
      {%- endcapture -%}

      {%- capture one_time_card -%}
        {%- liquid
          assign is_checked = false
          if selected == 'onetime'
            assign is_checked = true
          endif
        -%}
        {% render 'dm-purchase-card',
          option: 'onetime',
          group_name: group_name,
          checked: is_checked,
          badge: bs.one_badge,
          title: bs.one_title,
          price: variant.price,
          compare: variant.compare_at_price,
          subtitle: bs.one_subtitle,
          perks: bs.one_perks
        %}
      {%- endcapture -%}

      {%- if bs.one_time_first and show_one_time -%}
        {{ one_time_card }}
        {{ subscription_cards }}
      {%- else -%}
        {{ subscription_cards }}
        {%- if show_one_time -%}
          {{ one_time_card }}
        {%- endif -%}
      {%- endif -%}
    </div>

    <input
      type="hidden"
      name="selling_plan"
      form="{{ form_id }}"
      value="{{ default_plan_id }}"
      data-dm-selling-plan
      {% if has_plans == false or selected != 'subscription' %}
        disabled
      {% endif %}
    >

    {%- if has_plans == false and request.design_mode -%}
      <p class="dm-purchase__notice">
        {% render 'dm-placeholder-flag' %}
        {{ 'dm.purchase.demo_notice' | t }}
      </p>
    {%- endif -%}

    {%- if bs.footnote != blank -%}
      <div class="dm-purchase__footnote">{{ bs.footnote }}</div>
    {%- endif -%}

    <div class="dm-purchase__actions">
      {% content_for 'blocks' %}
    </div>
  </dm-purchase-options>
{% endif %}

{% stylesheet %}
  .dm-purchase {
    --dm-line: rgb(var(--color-foreground-rgb) / 0.35);
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .dm-purchase__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .dm-purchase__label {
    margin: 0;
    font-size: var(--font-paragraph--size);
  }

  .dm-purchase__link {
    font-size: 0.8125rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .dm-purchase__options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dm-option {
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 14px;
    padding: 18px 18px 16px;
    border: var(--dm-card-border, 1px) solid var(--dm-line);
    border-radius: var(--dm-card-radius, 0);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .dm-option--badge {
    margin-top: 12px;
    padding-top: 22px;
  }

  .dm-option:hover {
    border-color: var(--color-foreground);
  }

  .dm-option:has(.dm-option__input:checked) {
    background: var(--dm-selected-bg, transparent);
    border-color: var(--color-foreground);
    box-shadow: inset 0 0 0 var(--dm-card-border, 1px) var(--color-foreground);
  }

  .dm-option:has(.dm-option__input:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .dm-option__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
    pointer-events: none;
  }

  .dm-option__badge {
    position: absolute;
    top: 0;
    left: 50px;
    transform: translateY(-50%);
    padding: 4px 10px;
    background: var(--dm-accent);
    color: #fff;
    font-family: var(--dm-option-badge-font, var(--font-subheading--family));
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: min(var(--dm-card-radius, 0px), 4px);
    max-width: calc(100% - 66px);
  }

  .dm-option__radio {
    grid-row: 1 / span 4;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-background);
  }

  .dm-option__radio::after {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-foreground);
    transform: scale(0);
    transition: transform 0.15s ease;
  }

  .dm-option__input:checked ~ .dm-option__radio::after {
    transform: scale(1);
  }

  .dm-option__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .dm-option__top,
  .dm-option__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .dm-option__title {
    font-family: var(--dm-option-title-font, var(--font-subheading--family));
    font-weight: var(--dm-option-title-weight, var(--font-subheading--weight));
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  .dm-option__price {
    white-space: nowrap;
    font-family: var(--dm-option-title-font, var(--font-subheading--family));
    font-weight: var(--dm-option-title-weight, var(--font-subheading--weight));
    font-size: 1.0625rem;
  }

  .dm-option__suffix {
    font-size: 0.875rem;
  }

  .dm-option__subtitle {
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .dm-option__compare {
    font-size: 0.8125rem;
    opacity: 0.7;
    white-space: nowrap;
  }

  .dm-option__compare:empty {
    display: none;
  }

  .dm-option__frequency {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.875rem;
  }

  .dm-option__select {
    font: inherit;
    color: inherit;
    padding: 6px 28px 6px 10px;
    border: 1px solid var(--dm-line);
    border-radius: min(var(--dm-card-radius, 0px), 6px);
    background-color: var(--color-input-background, transparent);
  }

  .dm-option__perks {
    margin-top: 6px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--dm-accent);
  }

  .dm-purchase--perks-inline .dm-option__perk:not(:last-child)::after {
    content: ' | ';
    white-space: pre;
  }

  .dm-purchase--perks-list .dm-option__perks {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: inherit;
  }

  .dm-purchase--perks-list .dm-option__perk::before {
    content: '↳ ';
    color: var(--dm-accent);
  }

  .dm-purchase__notice {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .dm-purchase__footnote {
    font-size: 0.75rem;
    line-height: 1.45;
    text-align: center;
    opacity: 0.85;
  }

  .dm-purchase__footnote p {
    margin: 0;
  }

  .dm-purchase__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dm-purchase__actions .popup-link {
    width: 100%;
  }

  .dm-purchase__actions .popup-link__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--height-buy-buttons, 48px);
    padding: 0 1.25rem;
    border: var(--style-border-width-secondary, 1px) solid var(--color-secondary-button-border);
    border-radius: var(--style-border-radius-buttons-secondary, 0);
    color: var(--color-secondary-button-text);
    background: var(--color-secondary-button-background);
    font-family: var(--button-font-family-secondary, var(--font-body--family));
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .dm-purchase__actions .popup-link__button:hover {
    background: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
  }

  .dm-purchase__actions .popup-link__button svg {
    display: none;
  }

  /* Supplement Facts popup: compact card on desktop, bottom sheet on mobile */
  .dm-purchase .popup-link__content {
    width: min(480px, calc(100vw - 32px));
    max-width: none;
    height: fit-content;
    max-height: min(90dvh, 920px);
    padding: 52px 28px 28px;
    border: 0;
    border-radius: 0;
    overscroll-behavior: contain;
  }

  .dm-purchase .popup-link__close {
    top: 10px;
    inset-inline-end: 10px;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 50%;
    opacity: 1;
  }

  .dm-purchase .popup-link__close:hover {
    border-color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .dm-purchase .popup-link__content {
      width: 100%;
      max-width: 100%;
      max-height: 88dvh;
      margin: auto 0 0;
      padding: 52px 16px calc(24px + var(--safe-area-inset-bottom, 0px));
    }

    .dm-purchase .popup-link__content[open] {
      animation: dmSheetIn 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .dm-purchase .popup-link__content.dialog-closing {
      animation: dmSheetOut 0.2s ease-in both;
    }
  }

  @keyframes dmSheetIn {
    from {
      transform: translateY(32px);
      opacity: 0;
    }
  }

  @keyframes dmSheetOut {
    to {
      transform: translateY(32px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-purchase .popup-link__content[open],
    .dm-purchase .popup-link__content.dialog-closing {
      animation-duration: 1ms;
    }
  }

  .dm-atc-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    margin-inline-start: 0.75em;
    padding-inline-start: 0.75em;
    border-inline-start: 1px solid currentColor;
  }

  .dm-atc-price s {
    opacity: 0.7;
    font-weight: 400;
  }

  /* Narrow phones: keep "Add to cart | price" on one line */
  @media screen and (max-width: 419px) {
    .dm-atc-price s {
      display: none;
    }

    .dm-atc-price {
      margin-inline-start: 0.5em;
      padding-inline-start: 0.5em;
    }

    .dm-purchase .add-to-cart-button {
      padding-inline: 12px;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
  }

  .sticky-add-to-cart__variant {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dm-sticky-price s {
    margin-inline-start: 0.35em;
    font-weight: 400;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    sticky-add-to-cart .sticky-add-to-cart__bar {
      gap: 10px;
    }

    sticky-add-to-cart .sticky-add-to-cart__bar .sticky-add-to-cart__price {
      display: none;
    }

    sticky-add-to-cart .sticky-add-to-cart__bar .sticky-add-to-cart__button {
      flex: 0 0 auto;
      width: auto;
      padding-inline: 18px;
    }

    sticky-add-to-cart .sticky-add-to-cart__bar .sticky-add-to-cart__button .svg-wrapper {
      display: none;
    }

    sticky-add-to-cart .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: inline;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .dm-purchase--buttons-first .dm-purchase__actions {
      display: contents;
    }

    .dm-purchase--buttons-first .dm-purchase__actions > .buy-buttons-block {
      order: -1;
    }

    .dm-option {
      padding-inline: 14px;
      column-gap: 12px;
    }

    .dm-option__badge {
      left: 46px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Purchase options",
  "tag": null,
  "blocks": [
    {
      "type": "buy-buttons"
    },
    {
      "type": "popup-link"
    },
    {
      "type": "dm-supplement-facts"
    },
    {
      "type": "dm-checklist"
    },
    {
      "type": "text"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Subscription prices come from the product's selling plans (Recharge creates them natively). If the product has no selling plans, the subscription card shows demo pricing and adds a one-time purchase to the cart."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label above options"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label (right)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "default_option",
      "label": "Selected by default",
      "options": [
        {
          "value": "subscription",
          "label": "Subscription"
        },
        {
          "value": "onetime",
          "label": "One-time purchase"
        }
      ],
      "default": "subscription"
    },
    {
      "type": "checkbox",
      "id": "one_time_first",
      "label": "Show one-time card first",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_button_price",
      "label": "Show selected price in Add to cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_buttons_first",
      "label": "Mobile: show Add to cart above the options",
      "default": true
    },
    {
      "type": "number",
      "id": "servings",
      "label": "Servings per pouch",
      "info": "Used for the price per serving.",
      "default": 25
    },
    {
      "type": "header",
      "content": "Subscription card"
    },
    {
      "type": "text",
      "id": "sub_badge",
      "label": "Badge",
      "default": "Most popular - Get 15% off for life"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Title",
      "default": "Delivered Monthly"
    },
    {
      "type": "text",
      "id": "sub_price_suffix",
      "label": "Price suffix",
      "default": "/month"
    },
    {
      "type": "checkbox",
      "id": "show_per_serving",
      "label": "Show price per serving",
      "default": true
    },
    {
      "type": "text",
      "id": "per_serving_suffix",
      "label": "Per serving suffix",
      "default": "/serving"
    },
    {
      "type": "text",
      "id": "sub_subtitle",
      "label": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "sub_perks",
      "label": "Perks",
      "info": "One per line.",
      "default": "Free frother ($25 value)\nFree shipping delivered every 30 days\nCancel anytime, no commitment\n60-Day Money Back Guarantee"
    },
    {
      "type": "select",
      "id": "plan_display",
      "label": "Selling plans shown",
      "options": [
        {
          "value": "single",
          "label": "Default plan only"
        },
        {
          "value": "selector",
          "label": "One card with a frequency selector"
        },
        {
          "value": "cards",
          "label": "One card per plan"
        }
      ],
      "default": "single"
    },
    {
      "type": "checkbox",
      "id": "auto_badges",
      "label": "Cards per plan: automatic discount badge",
      "default": true,
      "visible_if": "{{ block.settings.plan_display == 'cards' }}"
    },
    {
      "type": "text",
      "id": "auto_badge_format",
      "label": "Automatic badge text",
      "info": "[percent] is replaced by the plan discount.",
