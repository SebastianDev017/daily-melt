      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "inline",
          "label": "Inline row"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "circle_check",
          "label": "Circle check"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "return",
          "label": "Return arrow (↳)"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "check"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "base",
          "label": "Base"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "base"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "icon_color",
