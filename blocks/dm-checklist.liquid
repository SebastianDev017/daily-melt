{%- doc -%}
  Daily Melt — icon list. One item per line in the "Items" field.
  Used for the benefit row, key benefit bullets and trust badges on the PDP,
  and for card / panel bullet lists in the Daily Melt sections.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign items = bs.items | newline_to_br | split: '<br />'
-%}

<div
  class="dm-checklist dm-checklist--{{ bs.layout }} dm-checklist--{{ bs.text_size }} dm-checklist--align-{{ bs.alignment }} spacing-style"
  style="{% render 'spacing-style', settings: bs %} {% render 'dm-font-var', name: 'checklist-heading', font: bs.dm_font_heading, text_case: bs.dm_case_heading %}{% if bs.icon_color != blank %} --dm-icon-color: {{ bs.icon_color }};{% endif %}{% if bs.text_color != blank %} --dm-text-color: {{ bs.text_color }};{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if bs.heading != blank -%}
    <p class="dm-checklist__heading">{{ bs.heading }}</p>
  {%- endif -%}
  <ul class="dm-checklist__list" role="list">
    {%- for item in items -%}
      {%- assign label = item | strip -%}
      {%- if label != blank -%}
        <li class="dm-checklist__item">
          {%- unless bs.icon == 'none' -%}
            <span class="dm-checklist__icon" aria-hidden="true">{% render 'dm-icon', icon: bs.icon %}</span>
          {%- endunless -%}
          <span class="dm-checklist__text">{{ label }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .dm-checklist {
    --dm-icon-size: 1.1em;
    color: var(--dm-text-color, inherit);
    width: 100%;
  }

  .dm-checklist__heading {
    margin: 0 0 0.6em;
    font-family: var(--dm-checklist-heading-font, var(--font-subheading--family));
    font-weight: var(--dm-checklist-heading-weight, var(--font-subheading--weight));
  }

  .dm-checklist__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45em;
  }

  .dm-checklist__item {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    line-height: 1.35;
  }

  .dm-checklist__icon {
    flex: 0 0 auto;
    display: inline-flex;
    width: var(--dm-icon-size);
    height: var(--dm-icon-size);
    margin-top: 0.12em;
    color: var(--dm-icon-color, var(--color-foreground));
  }

  .dm-checklist__icon svg {
    width: 100%;
    height: 100%;
  }

  .dm-checklist--inline .dm-checklist__list {
    flex-flow: row wrap;
    column-gap: 1.25em;
    row-gap: 0.5em;
  }

  .dm-checklist--inline .dm-checklist__item {
    align-items: center;
  }

  .dm-checklist--inline .dm-checklist__icon {
    margin-top: 0;
  }

  .dm-checklist--align-center {
    text-align: center;
  }

  .dm-checklist--align-center .dm-checklist__list {
    align-items: center;
  }

  .dm-checklist--align-center.dm-checklist--inline .dm-checklist__list {
    justify-content: center;
  }

  .dm-checklist--small {
    font-size: var(--font-paragraph-small--size, 0.875rem);
  }

  .dm-checklist--base {
    font-size: var(--font-paragraph--size);
  }

  .dm-checklist--large {
    font-size: calc(var(--font-paragraph--size) * 1.125);
  }

  /* Text case chosen in the section/block settings (only applies when one is picked) */
  [style*='--dm-checklist-heading-case'] .dm-checklist__heading {
    text-transform: var(--dm-checklist-heading-case);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Checklist",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "textarea",
      "id": "items",
