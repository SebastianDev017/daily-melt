{%- doc -%}
  Daily Melt — subscription offer callout: heading, intro, one gift per delivery, perks and a CTA
  that selects the subscription option and adds it to the cart.
{%- enddoc -%}

{%- assign bs = block.settings -%}
{%- assign perks = bs.perks | newline_to_br | split: '<br />' -%}

<div
  class="dm-gifts dm-gifts--{{ bs.style }} spacing-style"
  style="{% render 'spacing-style', settings: bs %} --dm-accent: {{ bs.accent_color }}; {% render 'dm-font-var', name: 'gifts-heading', font: bs.dm_font_heading, text_case: bs.dm_case_heading %}{% render 'dm-font-var', name: 'gift-name', font: bs.dm_font_gift, text_case: bs.dm_case_gift %}{% if bs.background != blank %} --dm-gifts-bg: {{ bs.background }};{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if bs.heading != blank -%}
    <h3 class="dm-gifts__heading">{{ bs.heading }}</h3>
  {%- endif -%}
  {%- if bs.text != blank -%}
    <div class="dm-gifts__text">{{ bs.text }}</div>
  {%- endif -%}

  <ol class="dm-gifts__list" role="list">
    {% content_for 'blocks' %}
  </ol>

  {%- if perks.size > 0 -%}
    <ul class="dm-gifts__perks" role="list">
      {%- for perk in perks -%}
        {%- assign perk_text = perk | strip -%}
        {%- if perk_text != blank -%}
          <li><span class="dm-gifts__perk-icon" aria-hidden="true">{% render 'dm-icon', icon: 'check' %}</span>{{ perk_text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if bs.cta_label != blank -%}
    {%- if bs.cta_action == 'subscribe' -%}
      <button type="button" class="button dm-gifts__cta" data-dm-subscribe-cta>{{ bs.cta_label }}</button>
    {%- else -%}
      <a class="button dm-gifts__cta" href="{{ bs.cta_link | default: '#' }}">{{ bs.cta_label }}</a>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .dm-gifts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    text-align: center;
  }

  .dm-gifts--panel {
    padding: 28px 20px;
    background: var(--dm-gifts-bg, transparent);
  }

  .dm-gifts--lines {
    padding: 24px 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
  }

  .dm-gifts__heading {
    margin: 0;
    color: var(--dm-accent);
    font-family: var(--dm-gifts-heading-font, var(--font-heading--family));
    font-weight: var(--dm-gifts-heading-weight, var(--font-heading--weight));
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .dm-gifts__text {
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .dm-gifts__text p {
    margin: 0;
  }

  .dm-gifts__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 16px 12px;
    width: 100%;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .dm-gifts__perks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 18px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .dm-gifts__perks li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .dm-gifts__perk-icon {
    flex: 0 0 auto;
    width: 1.05em;
    height: 1.05em;
    margin-top: 0.1em;
    color: var(--dm-accent);
  }

  .dm-gifts__perk-icon svg {
    width: 100%;
    height: 100%;
  }

  .dm-gifts__cta {
    width: 100%;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .dm-gifts__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dm-gifts__perks {
      grid-template-columns: 1fr;
    }
  }

  /* Text case chosen in the section/block settings (only applies when one is picked) */
  [style*='--dm-gifts-heading-case'] .dm-gifts__heading {
    text-transform: var(--dm-gifts-heading-case);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DM · Subscription gifts",
  "tag": null,
  "blocks": [
    {
      "type": "_dm-gift"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe & Save 15%"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Build your complete Daily Melt ritual with a new subscriber gift in each of your first four deliveries.</p>"
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks",
      "info": "One per line.",
      "default": "Free frother in your first box\nFree recipe guidebook/e-book\nFree fast shipping\nBonus gifts in deliveries 2, 3, and 4\nSkip or cancel anytime"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start My Daily Melt Ritual"
    },
    {
      "type": "select",
      "id": "cta_action",
      "label": "Button action",
      "options": [
        {
          "value": "subscribe",
          "label": "Select subscription and add to cart"
        },
        {
          "value": "link",
          "label": "Link"
        }
      ],
      "default": "subscribe"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "visible_if": "{{ block.settings.cta_action == 'link' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "lines",
          "label": "Lines above and below"
        },
        {
          "value": "panel",
          "label": "Panel"
        }
      ],
      "default": "lines"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Panel background",
      "visible_if": "{{ block.settings.style == 'panel' }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.color_palette.accent }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "dm_font_heading",
      "label": "Heading font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "dm_case_heading",
      "label": "Heading case",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "dm_font_gift",
      "label": "Gift names font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "subheading"
    },
    {
      "type": "select",
      "id": "dm_case_gift",
      "label": "Gift names case",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ],
      "default": "",
      "info": "Fonts come from Theme settings > Typography. Case: Default keeps the design."
    }
  ],
  "presets": [
    {
      "name": "DM · Subscription gifts"
    }
  ]
}
{% endschema %}
