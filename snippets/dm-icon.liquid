{%- doc -%}
  Daily Melt — inline SVG icons (stroke/fill use currentColor).

  @param {string} icon - circle_check | check | arrow | return | dot | star | lock | plus | chevron_down | shield | leaf | flask | badge | truck | repeat
  @param {string} [class] - Optional class on the svg

  @example
  {% render 'dm-icon', icon: 'check' %}
{%- enddoc -%}

{%- case icon -%}
  {%- when 'circle_check' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.75" stroke="currentColor" stroke-width="1.5"/><path d="M6.2 10.3l2.5 2.4 5.1-5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M4 10.6l3.8 3.7L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow' -%}
    <svg class="{{ class }}" viewBox="0 0 24 20" fill="none" aria-hidden="true" focusable="false"><path d="M2 10h19m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'return' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M5 3v7.5h11m-3.5-3.5L16 10.5 12.5 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'dot' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="3.2" fill="currentColor"/></svg>
  {%- when 'star' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.6l2.6 5.3 5.8.85-4.2 4.1 1 5.8L10 14.9l-5.2 2.75 1-5.8-4.2-4.1 5.8-.85L10 1.6z" fill="currentColor"/></svg>
  {%- when 'lock' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><rect x="4" y="9" width="12" height="9" rx="1.5" fill="currentColor"/><path d="M6.8 9V6.6a3.2 3.2 0 0 1 6.4 0V9" stroke="currentColor" stroke-width="1.8"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M10 2.5v15M2.5 10h15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'chevron_down' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 2.8l7.5 3v5.6c0 4.6-3.1 8.4-7.5 9.8-4.4-1.4-7.5-5.2-7.5-9.8V5.8l7.5-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 12l2.4 2.3 4.6-4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'leaf' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 19C4 11 9 5 20 4c-.6 10.4-6.2 15.4-14 15z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M5 19c3-4.5 6.5-8 10.5-10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'flask' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M9.5 3h5M10.3 3v6.2L4.8 18.4A1.8 1.8 0 0 0 6.4 21h11.2a1.8 1.8 0 0 0 1.6-2.6l-5.5-9.2V3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7.2 15h9.6" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'badge' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="10" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M8.6 15.4 7.5 21.5l4.5-2.3 4.5 2.3-1.1-6.1" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.4 10.1l1.8 1.8 3.5-3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3.5 3.5v2.5h-7.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6.5" cy="17" r="1.8" fill="var(--color-background, #fff)" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="17" r="1.8" fill="var(--color-background, #fff)" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'repeat' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M4 8.5a6 6 0 0 1 10.3-3.6L16 6.6M16 3v3.6h-3.6M16 11.5a6 6 0 0 1-10.3 3.6L4 13.4M4 17v-3.6h3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
