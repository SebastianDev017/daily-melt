            "description": {
              "type": "text",
              "settings": {
                "text": "<p>Daily Melt is a rich, creamy chocolate drink with clinically-studied ingredients that support natural GLP-1, satiety, healthy metabolism, and gut health.*</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              },
              "blocks": {}
            },
            "key_benefits": {
              "type": "dm-checklist",
              "settings": {
                "items": "Feeling fuller for longer\nCalming cravings between meals\nSatisfying your sweet tooth\nSupporting natural appetite control\n25 servings per pouch",
                "layout": "stacked",
                "icon": "check",
                "text_size": "base",
                "alignment": "left"
              }
            },
            "accordion": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.foreground }}",
                "type_preset": "h5",
                "padding-block-start": 8,
